root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Inno Setup reads these on Windows: UTF-8 with BOM and CRLF.
[installer/*.{iss,txt}]
charset = utf-8-bom
end_of_line = crlf
